# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_SUMMARY_MODEL=gemini-3-flash-preview
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_SEARCH_THRESHOLD=0.3

# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=AI-Daily-Survey/1.0

# Qiita API (https://qiita.com/settings/tokens/new)
QIITA_ACCESS_TOKEN=your_qiita_token_here

# SMTP (メール通知)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TO=your_email@gmail.com

# スケジューラ (JST 12:00 = UTC 03:00)
# arXiv の submittedDate インデックス反映を待つため正午に実行（9時=UTC0時だと当日分が0件になりやすい）
SCHEDULE_HOUR=12
SCHEDULE_MINUTE=0

# GitHub API (任意: レートリミット緩和 60→5000 req/h)
# https://github.com/settings/tokens で発行（スコープ不要）
GITHUB_TOKEN=

# アプリ設定
# 注: APP_HOST / APP_PORT は config.py からは読み込まれない（互換のため残置）。
#     実際の host/port は Dockerfile の uvicorn CMD と docker-compose.yml のポートマッピングで固定。
APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=data
SUMMARIES_DIR=summaries
DB_PATH=db/survey.db
LOG_DIR=logs
